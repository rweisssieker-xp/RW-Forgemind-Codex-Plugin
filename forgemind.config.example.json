{
  "schemaVersion": 1,
  "policy": {
    "actions": {
      "destructive": "deny",
      "deployment": "approval",
      "migration": "approval",
      "network": "approval",
      "cost": "approval"
    },
    "protectedPaths": [
      ".git/",
      ".env",
      "infra/production/"
    ]
  },
  "redaction": {
    "allowlist": [
      "EXAMPLE_TOKEN"
    ]
  },
  "routing": {
    "maxSkillTokens": 800
  },
  "autopilot": {
    "adapters": [
      {
        "type": "local-command",
        "operations": ["test"],
        "rollback": { "kind": "none", "reason": "Tests do not mutate project state." }
      }
    ],
    "connectors": [
      { "type": "read-only-connector", "environment": "sandbox", "operations": ["observe"], "rollback": { "kind": "none" } }
    ]
  }
}
